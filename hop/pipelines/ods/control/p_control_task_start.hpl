  <transform>
    <type>ExecSql</type>
    <name>Execute SQL Success</name>
    <connection>ods_postgres</connection>
    <sql>UPDATE control.batch_task
SET
    status = 'SUCCESS',
    completed_at = CURRENT_TIMESTAMP,

    source_row_count = ?,
    accepted_row_count = ?,
    rejected_row_count = ?,
    error_count = ?,

    error_code = NULL,
    error_message = NULL,
	hop_run_id = ?,
    updated_at = CURRENT_TIMESTAMP
WHERE batch_task_id = ?
  AND status = 'RUNNING';</sql>
    <execute_each_row>Y</execute_each_row>
