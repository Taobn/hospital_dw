<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>PRM_SOURCE_CODE</name>
        <description/>
        <default_value>HIS</default_value>
      </parameter>
    </parameters>
    <name/>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/16 09:34:08.890</created_date>
    <modified_date>2026/09/16 09:34:08.890</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    s.dataset_code
FROM control.data_source d
LEFT JOIN control.data_source_instance i
	ON i.data_source_id = d.data_source_id
LEFT JOIN control.dataset s
	ON s.source_instance_id = i.source_instance_id
	
WHERE d.source_code = '${PRM_SOURCE_CODE}'
  AND d.is_active = TRUE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>ods_postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>240</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>RowsToResult</type>
    <name>Copy rows to result</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>432</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Write to log</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage/>
    <loglevel>Basic</loglevel>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Table input</from>
      <to>Copy rows to result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Copy rows to result</from>
      <to>Write to log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
