  <transform>
    <type>TableInput</type>
    <name>Check Watermark</name>
    <sql>SELECT
	? AS batch_id,
    w.last_value_timestamp AS current_watermark,
    CAST(? AS TIMESTAMPTZ) AS batch_max_updated_date,

    CASE
        WHEN CAST(? AS TIMESTAMPTZ) IS NULL
            THEN 'NO_DATA'

        WHEN w.last_value_timestamp IS NULL
            THEN 'INITIALIZE'

        WHEN CAST(? AS TIMESTAMPTZ) >= w.last_value_timestamp
            THEN 'PASS'

        ELSE 'FAIL_WATERMARK_REGRESSION'
    END AS watermark_check

FROM control.watermark w
WHERE w.dataset_id = (
    SELECT dataset_id
    FROM control.batch
    WHERE batch_id = ?
)
AND w.is_active = TRUE;</sql>
