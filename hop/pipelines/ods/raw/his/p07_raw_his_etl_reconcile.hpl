<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>PRM_SQL_RETURN_ETL_STATISTICS</name>
        <description/>
        <default_value>WITH stage_stats AS (
    SELECT
        COUNT(*) AS stage_row_count,
        MIN(updated_date) AS min_updated_date,
        MAX(updated_date) AS max_updated_date
    FROM raw.ods_raw_exam_stage
    WHERE batch_id = 113
),
reject_stats AS (
    SELECT
        COUNT(*) AS total_rejected_row_count,
        COUNT(*) FILTER (
            WHERE error_code IN (
                'VALIDATION_REQUIRED_FIELD'
            )
        ) AS initial_rejected_row_count,
        COUNT(*) FILTER (
            WHERE error_code = 'VALIDATION_DUPLICATE_BUSINESS_KEY'
        ) AS duplicate_rejected_row_count
    FROM raw.ods_raw_exam_reject
    WHERE batch_id = 113
),
calculated AS (
    SELECT
        113::BIGINT AS batch_id,
        s.stage_row_count,
        r.initial_rejected_row_count,
        r.duplicate_rejected_row_count,
        r.total_rejected_row_count,
        s.stage_row_count
           - r.duplicate_rejected_row_count
           AS accepted_row_count,
        s.stage_row_count
            + r.initial_rejected_row_count
            AS source_row_count,
        s.min_updated_date,
        s.max_updated_date
    FROM stage_stats s
    CROSS JOIN reject_stats r
)
SELECT
    c.*,
    CASE
        WHEN c.source_row_count
             =
             c.accepted_row_count
             + c.total_rejected_row_count
        THEN 'PASS'
       ELSE 'FAIL'
   END AS statistics_status
FROM calculated c;</default_value>
      </parameter>
      <parameter>
        <name>PRM_BATCH_ID</name>
        <description/>
        <default_value>113</default_value>
      </parameter>
    </parameters>
    <name>p07_raw_his_etl_reconcile</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/24 10:19:38.577</created_date>
    <modified_date>2026/09/24 10:19:38.577</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT
    batch_id,

    CASE
        WHEN status &lt;&gt; 'RUNNING'
            THEN 'FAIL_BATCH_STATUS'

        WHEN error_count &lt;&gt; 0
            THEN 'FAIL_ERROR_COUNT'

        WHEN source_row_count IS NULL
            THEN 'FAIL_SOURCE_COUNT_NULL'

        WHEN accepted_row_count IS NULL
            THEN 'FAIL_ACCEPTED_COUNT_NULL'

        WHEN rejected_row_count IS NULL
            THEN 'FAIL_REJECTED_COUNT_NULL'

        WHEN source_row_count
             &lt;&gt;
             accepted_row_count + rejected_row_count
            THEN 'FAIL_COUNT_MISMATCH'

        ELSE 'PASS'
    END AS reconcile_status

FROM control.batch
WHERE batch_id = ${PRM_BATCH_ID};</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>ods_postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>112</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Return ETL Statistics</name>
    <sql>${PRM_SQL_RETURN_ETL_STATISTICS}</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>ods_postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>112</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>StreamLookup</type>
    <name>Stream lookup</name>
    <from>Return ETL Statistics</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key>
        <name>batch_id</name>
        <field>batch_id</field>
      </key>
      <value>
        <name>min_updated_date</name>
        <rename>min_updated_date</rename>
        <default/>
        <type>Timestamp</type>
      </value>
      <value>
        <name>max_updated_date</name>
        <rename>max_updated_date</rename>
        <default/>
        <type>Timestamp</type>
      </value>
      <value>
        <name>statistics_status</name>
        <rename>statistics_status</rename>
        <default/>
        <type>String</type>
      </value>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SwitchCase</type>
    <name>Switch / case</name>
    <fieldname>reconcile_status</fieldname>
    <case_value_type/>
    <case_value_format/>
    <case_value_decimal/>
    <case_value_group/>
    <cases>
      <case>
        <value>PASS</value>
        <target_transform>Execute SQL script</target_transform>
      </case>
    </cases>
    <default_target_transform/>
    <use_contains>N</use_contains>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>432</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Execute SQL script</name>
    <connection/>
    <sql>BEGIN;

UPDATE control.batch
SET
    status = 'SUCCESS',
    completed_at = CURRENT_TIMESTAMP,
    updated_at = CURRENT_TIMESTAMP
WHERE batch_id = ?
  AND status = 'RUNNING';

UPDATE control.watermark w
SET
    last_value_timestamp = ?,
    last_batch_id = ?,
    initialized_at = COALESCE(
        w.initialized_at,
        CURRENT_TIMESTAMP
    ),
    updated_at = CURRENT_TIMESTAMP
WHERE w.dataset_id = (
    SELECT dataset_id
    FROM control.batch
    WHERE batch_id = ?
)
AND w.is_active = TRUE;

COMMIT;</sql>
    <execute_each_row>N</execute_each_row>
    <update_field/>
    <insert_field/>
    <delete_field/>
    <read_field/>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>N</set_params>
    <arguments/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Return ETL Statistics</from>
      <to>Stream lookup</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Table input</from>
      <to>Stream lookup</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Stream lookup</from>
      <to>Switch / case</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Switch / case</from>
      <to>Execute SQL script</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
