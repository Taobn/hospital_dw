  <transform>
    <type>ExecSql</type>
    <name>PASS Execute update Batch &amp; Watermark</name>
    <connection>ods_postgres</connection>
    <sql>BEGIN;

WITH finalized AS (
    UPDATE control.batch
    SET
        status = 'SUCCESS',
        completed_at = CURRENT_TIMESTAMP,
        updated_at = CURRENT_TIMESTAMP,
        error_code = NULL,
        error_message = NULL
    WHERE batch_id = ?
      AND status = 'RUNNING'
    RETURNING batch_id, dataset_id
)
UPDATE control.watermark w
SET
    last_value_timestamp = CAST(? AS TIMESTAMPTZ),
    last_batch_id = f.batch_id,
    updated_at = CURRENT_TIMESTAMP
FROM finalized f
WHERE w.dataset_id = f.dataset_id
  AND w.is_active = TRUE
  AND CAST(? AS TIMESTAMPTZ) IS NOT NULL
  AND (
      w.last_value_timestamp IS NULL
      OR CAST(? AS TIMESTAMPTZ) >= w.last_value_timestamp
  );

COMMIT;</sql>
