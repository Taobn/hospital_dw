    <sql>UPDATE control.batch
SET
    status = 'FAILED',
    completed_at = CURRENT_TIMESTAMP,
    error_count = error_count + 1,
    error_code = 'WATERMARK_NOT_FOUND',
    error_message = format(
        'No active watermark configuration found for dataset_id=%s.',
        (
            SELECT dataset_id
            FROM control.batch
            WHERE batch_id = ?
        )
    ),
    updated_at = CURRENT_TIMESTAMP
WHERE batch_id = ?
  AND status = 'RUNNING';</sql>
