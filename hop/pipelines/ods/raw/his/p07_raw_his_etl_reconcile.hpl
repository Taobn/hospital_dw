    <type>TableInput</type>
    <name>Check found Watermark</name>
    <sql>SELECT
    b.batch_id,
	CAST(? AS TIMESTAMPTZ) AS max_updated_date,
    b.dataset_id,
    w.watermark_id,
    w.last_value_timestamp,
	CASE WHEN w.watermark_id is not null
		THEN 'WATERMARK_FOUND' ELSE NULL END AS status
FROM control.batch b
LEFT JOIN control.watermark w
    ON w.dataset_id = b.dataset_id
   AND w.is_active = TRUE
WHERE b.batch_id = ?;</sql>
    <limit>0</limit>
    <execute_each_row>Y</execute_each_row>
