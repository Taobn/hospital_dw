    <connection>ods_postgres</connection>
    <sql>UPDATE control.batch b
SET
    status = 'FAILED',
    completed_at = CURRENT_TIMESTAMP,
    error_count = error_count + 1,
    error_code = 'WATERMARK_REGRESSION',
    error_message = 'Batch max updated timestamp ' || ? || ' is earlier than current watermark ' || ? || '.',
    updated_at = CURRENT_TIMESTAMP
FROM control.watermark w
WHERE b.dataset_id = w.dataset_id
  AND w.is_active = TRUE
  AND b.batch_id = ?
  AND b.status = 'RUNNING';</sql>
