    <name>Execute SQL script</name>
    <connection>ods_postgres</connection>
    <sql>INSERT INTO control.batch_task (
    batch_id,
    task_code,
    task_name,
    execution_order
)
VALUES
    (?, 'CONTEXT',    'Build execution context', 1),
    (?, 'EXTRACT',    'Extract source data',     2),
    (?, 'STAGE',      'Load staging data',       3),
    (?, 'REJECT',     'Process rejected data',   4),
    (?, 'LOAD',       'Load target data',        5),
    (?, 'STATISTICS', 'Collect statistics',      6),
    (?, 'RECONCILE',  'Reconcile results',       7);</sql>
