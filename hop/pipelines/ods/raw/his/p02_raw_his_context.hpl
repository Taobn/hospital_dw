  <transform>
    <type>TableInput</type>
    <name>Target object mapping</name>
    <sql>SELECT DISTINCT
	a.dataset_id,
	a.target_schema,
	a.target_object
FROM
	control.dataset_column_mapping a
LEFT JOIN
	control.dataset b ON b.dataset_id = a.dataset_id
WHERE
	b.dataset_code = '${PRM_DATASET_CODE}'
	AND a.is_nullable = FALSE
	AND a.target_layer = 'RAW';</sql>
    <limit>1</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>ods_postgres</connection>
    <lookup/>
    <sql_from_file/>
