  <transform>
    <type>ScriptValueMod</type>
    <name>05 Extraction SQL</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var sql;

// FULL extraction
if (extraction_mode == "FULL") {
    sql =   "SELECT " + source_instance_id + " AS runtime_source_instance_id, " + "\n"
					  +	batch_id + " AS runtime_batch_id, "+ "\n"
					  + "a.*" + "\n" +
			" FROM " + source_schema + "." + source_object + " a" + "\n" +
			" WHERE ROWNUM &lt;= 10";
}

// INCREMENTAL extraction
else {

    if (cursor_data_type == "TIMESTAMP") {
        sql =
            "SELECT " + source_instance_id + " AS runtime_source_instance_id, " + "\n"
					  +	batch_id + " AS runtime_batch_id, " + "\n"
					  + "a.*" + "\n" +
			" FROM " + source_schema + "." + source_object + " a" + "\n" + 
            " WHERE a." + cursor_column + "\n" +
            " > TO_TIMESTAMP('" + effective_from + "', 'YYYY-MM-DD HH24:MI:SS')" + "\n" +
			" AND ROWNUM &lt;= 10";
    }

    else if (cursor_data_type == "NUMERIC") {
        sql =
            "SELECT * FROM " + source_schema + "." + source_object + "\n" +
            " WHERE " + cursor_column + " > " + effective_from + "\n" +
			" AND ROWNUM &lt;= 10";
    }

    else if (cursor_data_type == "TEXT") {
        sql =
            "SELECT * FROM " + source_schema + "." + source_object + "\n" +
            " WHERE " + cursor_column + " > '" + effective_from + "'"  + "\n" +
			" AND ROWNUM &lt;= 10";
    }
}

var target_object_stage          = target_object ? target_object + "_stage" : null;
var target_object_reject         = target_object ? target_object + "_reject" : null;
var target_object_extended_stage = target_object ? target_object + "_extended_stage" : null;
var target_object_extended        = target_object ? target_object + "_extended" : null;

var source_key_composite;

// Kiểm tra nếu source_key_1 có giá trị thực sự (khác null, khác chuỗi rỗng và khác khoảng trắng)
	if (source_key_1 != "null") {
    	source_key_composite = source_key_1;
	} else {
    	source_key_composite = source_key; 
	}

var target_key_composite1;
var target_key_composite2;
var target_key_composite3;
var source_key_composite;
	if (target_key_1 != "null") {
		target_key_composite1 = "s." + target_key +","+ "\n" +"   s." + target_key_1 +","
		target_key_composite2 = target_key +","+ "\n" + "        " + target_key_1
		target_key_composite3 = "AND d." + target_key + " = s." + target_key +  "\n" +
								"    AND d." + target_key_1 + " = s." + target_key_1
		source_key_composite = source_key + "; " + source_key_1
	} else {
		target_key_composite1 = "s." + target_key +","
		target_key_composite2 = target_key
		target_key_composite3 = "AND d." + target_key + " = s." + target_key
		source_key_composite = source_key
	}	

var sql_read_duplicate_batch;

	sql_read_duplicate_batch = 
	"SELECT " + "\n" +
    "   s.source_instance_id," + "\n" +
	"   s.batch_id," + "\n" +
    "   CURRENT_TIMESTAMP AS rejected_at," + "\n" +
    "   "+target_key_composite1 + "\n" +
	"   s." + target_identity_key + "," + "\n" +
	"   s." + target_business_date_key + "," + "\n" +
	"   s.updated_date," + "\n" +
    "   'VALIDATION_DUPLICATE_BUSINESS_KEY' AS error_code," + "\n" +
	"   'Duplicate source key detected within the same extraction batch.' AS error_message," + "\n" +
	"   '"+ source_key_composite +"' AS error_field," + "\n" +
	"   'DUPLICATE_VALIDATION' AS rejection_stage" + "\n" +
	"FROM raw." + target_object_stage + " s " + "\n" +
	"JOIN ( " + "\n" +
    "    SELECT " + "\n" +
    "        source_instance_id," + "\n" +
    "        batch_id," + "\n" +
    "        "+target_key_composite2 + "\n" +
    "    FROM raw."+ target_object_stage + "\n" +
    "    WHERE batch_id = " + batch_id + "\n" +
    "    GROUP BY " + "\n" +
	"        source_instance_id," + "\n" +
	"        batch_id," + "\n" +
	"        "+target_key_composite2 + "\n" +
    "        HAVING COUNT(*) > 1 " + "\n" +
	"    ) d " + "\n" +
	"    ON  d.source_instance_id = s.source_instance_id " + "\n" +
	"    AND d.batch_id = s.batch_id " + "\n" +
	"    "+target_key_composite3 + "\n" +
	"WHERE s.batch_id = " + batch_id + ";"

var sql_return_etl_statistics;
	
	sql_return_etl_statistics = 
	"WITH stage_stats AS (" + "\n" +
    "    SELECT" + "\n" +
    "        COUNT(*) AS stage_row_count," + "\n" +
	"        MIN(updated_date) AS min_updated_date," + "\n" +
	"        MAX(updated_date) AS max_updated_date" + "\n" +
	"    FROM " + target_schema + "." + target_object_stage + "\n" +
	"    WHERE batch_id = " + batch_id + "\n" +
	")," + "\n" +

	"reject_stats AS (" + "\n" +
	"    SELECT" + "\n" +
	"        COUNT(*) AS total_rejected_row_count," + "\n" +
	"        COUNT(*) FILTER (" + "\n" +
	"            WHERE error_code IN (" + "\n" +
	"                'VALIDATION_REQUIRED_FIELD'" + "\n" +
	"            )" + "\n" +
	"        ) AS initial_rejected_row_count," + "\n" +

	"        COUNT(*) FILTER (" + "\n" +
	"            WHERE error_code = 'VALIDATION_DUPLICATE_BUSINESS_KEY'" + "\n" +
	"        ) AS duplicate_rejected_row_count" + "\n" +

	"    FROM " + target_schema + "." + target_object_reject + "\n" +
	"    WHERE batch_id = " + batch_id + "\n" +
	")," + "\n" +

	"calculated AS (" + "\n" +
	"    SELECT" + "\n" +
	"        " + batch_id + "::BIGINT AS batch_id," + "\n" +

	"        s.stage_row_count," + "\n" +

	"        r.initial_rejected_row_count," + "\n" +
	"        r.duplicate_rejected_row_count," + "\n" +
	"        r.total_rejected_row_count,"  + "\n" +

	"        s.stage_row_count" + "\n" +
	"           - r.duplicate_rejected_row_count" + "\n" +
	"           AS accepted_row_count," + "\n" +

	"        s.stage_row_count" + "\n" +
	"            + r.initial_rejected_row_count" + "\n" +
	"            AS source_row_count," + "\n" +

	"        s.min_updated_date," + "\n" +
	"        s.max_updated_date"  + "\n" +

	"    FROM stage_stats s" + "\n" +
	"    CROSS JOIN reject_stats r" + "\n" +
	")" + "\n" +

	"SELECT" + "\n" +
	"    c.*," + "\n" +

	"    CASE" + "\n" +
	"        WHEN c.source_row_count" + "\n" +
	"             =" + "\n" +
	"             c.accepted_row_count" + "\n" +
	"             + c.total_rejected_row_count" + "\n" +
	"        THEN 'PASS'" + "\n" +
	"       ELSE 'FAIL'" + "\n" +
	"   END AS statistics_status" + "\n" +

	"FROM calculated c;";

var sql_delete_stage;
	sql_delete_stage =
		"DELETE FROM raw." + target_object_stage + " s" + "\n" +
		" USING control.batch b" + "\n" +
		" WHERE s.batch_id = b.batch_id" + "\n" +
	  	" AND b.status = 'SUCCESS'" + "\n" +
		" AND b.completed_at &lt; CURRENT_TIMESTAMP - INTERVAL '14 days';"

var sql_delete_extended_stage;
	sql_delete_extended_stage =
		"DELETE FROM raw." + target_object_extended_stage + " s" + "\n" +
		" USING control.batch b" + "\n" +
		" WHERE s.batch_id = b.batch_id" + "\n" +
	  	" AND b.status = 'SUCCESS'" + "\n" +
		" AND b.completed_at &lt; CURRENT_TIMESTAMP - INTERVAL '14 days';"
</jsScript_script>
      </jsScript>
    </jsScripts>
