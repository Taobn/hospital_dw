  </info>
  <transform>
    <type>TableInput</type>
    <name>01 Read Dataset Metadata</name>
    <sql>SELECT
    d.dataset_id,
    d.dataset_code,
    d.source_instance_id,
    d.source_schema,
    d.source_object,
    d.refresh_mode,
	d.ingestion_config

FROM control.dataset d

WHERE d.dataset_code = '${PRM_DATASET_CODE}'
  AND d.is_active = TRUE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>ods_postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>01A Validate Dataset Metadata</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>dataset_code</leftvalue>
        <function>IS NOT NULL</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>dataset_code</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>source_instance_id</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>source_schema</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>source_object</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>refresh_mode</leftvalue>
            <function>IS NOT NULL</function>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>03 Read Ingestion</send_true_to>
    <send_false_to>Abort</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>256</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>02 Read Watermark</name>
    <sql>SELECT
	w.dataset_id,
	d.dataset_code,
    w.watermark_id,
    w.watermark_type,
    w.watermark_column,
    w.last_value_timestamp,
	w.last_value_numeric,
    w.last_value_text,
    w.last_batch_id,
    w.initialized_at
FROM control.watermark w
JOIN control.dataset d
    ON d.dataset_id = w.dataset_id
WHERE d.dataset_code = '${PRM_DATASET_CODE}'
  AND w.is_active = TRUE;
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>ods_postgres</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>04 Calculate Extraction Window</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var mode;
var eff;

// Determine FULL vs INCREMENTAL
if (force_full == "Y") {
    mode = "FULL";
} else if (strategy != "WATERMARK") {
    mode = "FULL";
} else {
    if (cursor_data_type == "TIMESTAMP" &amp;&amp; last_value_timestamp != null) {
        mode = "INCREMENTAL";
    } else if (cursor_data_type == "NUMERIC" &amp;&amp; last_value_numeric != null) {
        mode = "INCREMENTAL";
    } else if (cursor_data_type == "TEXT" &amp;&amp; last_value_text != null) {
        mode = "INCREMENTAL";
    } else {
        mode = "FULL";
    }
}

// Calculate effective_from
if (mode == "FULL") {
    eff = null;
} else {
    if (cursor_data_type == "TIMESTAMP") {
        var overlap = parseInt(overlap_minutes);
        var ts = new Date(last_value_timestamp);
        eff = new Date(ts.getTime() - overlap * 60000);
    } else if (cursor_data_type == "NUMERIC") {
        eff = last_value_numeric;
    } else if (cursor_data_type == "TEXT") {
        eff = last_value_text;
    }
}

</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>mode</name>
        <rename>extraction_mode</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>eff</name>
        <rename>effective_from</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <languageVersion>ES6</languageVersion>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
