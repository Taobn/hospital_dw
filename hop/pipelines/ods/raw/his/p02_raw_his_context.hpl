    <type>SetVariable</type>
    <name>06 Set HIS Context and SQL</name>
    <fields>
      <field>
        <field_name>source_instance_id</field_name>
        <variable_name>PRM_SOURCE_INSTANCE_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>source_schema</field_name>
        <variable_name>PRM_SOURCE_SCHEMA</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>source_object</field_name>
        <variable_name>PRM_SOURCE_OBJECT</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>batch_id</field_name>
        <variable_name>PRM_BATCH_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>business_date_key</field_name>
        <variable_name>PRM_BUSINESS_DATE_KEY</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>sql_oracle</field_name>
        <variable_name>PRM_SQL_ORACLE</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1664</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>05 Extraction SQL</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var sql;

// FULL extraction
if (extraction_mode == "FULL") {
    sql =   "SELECT " + source_instance_id + " AS runtime_source_instance_id, "
					  +	batch_id + " AS runtime_batch_id, "
					  + "a.*" +
			" FROM " + source_schema + "." + source_object + " a" +
			" WHERE ROWNUM &lt;= 10";
}

// INCREMENTAL extraction
else {

    if (cursor_data_type == "TIMESTAMP") {
        sql =
            "SELECT " + source_instance_id + " AS runtime_source_instance_id, "
					  +	batch_id + " AS runtime_batch_id, "
					  + "a.*" +
			" FROM " + source_schema + "." + source_object + " a" +
            " WHERE a." + cursor_column +
            " > TO_TIMESTAMP('" + effective_from + "', 'YYYY-MM-DD HH24:MI:SS')" +
			" AND ROWNUM &lt;= 10";
    }

    else if (cursor_data_type == "NUMERIC") {
        sql =
            "SELECT * FROM " + source_schema + "." + source_object +
            " WHERE " + cursor_column + " > " + effective_from +
			" AND ROWNUM &lt;= 10";
    }

    else if (cursor_data_type == "TEXT") {
        sql =
            "SELECT * FROM " + source_schema + "." + source_object +
            " WHERE " + cursor_column + " > '" + effective_from + "'" +
			" AND ROWNUM &lt;= 10";
    }
}

</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>sql</name>
        <rename>sql_oracle</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <languageVersion>ES6</languageVersion>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1504</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
