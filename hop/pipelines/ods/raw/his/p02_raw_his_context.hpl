    <name>p02_raw_his</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load structured HIS HMS_EXAM data into raw.ods_raw_exam using control metadata, watermark and batch control.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
