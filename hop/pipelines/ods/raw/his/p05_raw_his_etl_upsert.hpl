  <transform>
    <type>ScriptValueMod</type>
    <name>JavaScript SQL Core Upsert</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

// tách danh sách cột
var colsArr = cols.split(",");
var updatesArr;

if (target_key_1 != "null") {
    updatesArr = colsArr.filter(function(c) {
        c = c.trim();
        return c != target_key &amp;&amp;
               c != target_key_1;
    });
} else {
    updatesArr = colsArr.filter(function(c) {
        c = c.trim();
        return c != target_key;
    });
}

var selectCols = colsArr.map(c => "s." + c).join(",\n    ");
var insertCols = colsArr.join(",\n    ");
var updateSet = updatesArr.map(c => c + " = EXCLUDED." + c).join(",\n    ");

var whereUpdate =
    target_schema + "." + target_object +
    ".updated_date &lt; EXCLUDED.updated_date";

var target_key_composite1;
var target_key_composite2;
var target_key_composite3;
var target_key_composite4;
	if (target_key_1 != "null") {
		target_key_composite1 = "s." + target_key + " IS NOT NULL\n"+
								"  AND s." + target_key_1 + " IS NOT NULL\n"
		target_key_composite2 = "d." + target_key + " = s." + target_key + "\n" +
								"        AND d." + target_key_1 + " = s." + target_key_1 + "\n"
		target_key_composite3 = "d." + target_key + ",\n" +
								"        d." + target_key_1 + "\n"
		target_key_composite4 = target_key + "," + target_key_1
	} else {
		target_key_composite1 = "s." + target_key + " IS NOT NULL\n"
		target_key_composite2 = "d." + target_key + " = s." + target_key + "\n"
		target_key_composite3 = "d." + target_key + "\n"
		target_key_composite4 = target_key
	}

var conflictCols = "(source_instance_id," + target_key_composite4 + ")";	

var sql =
    "INSERT INTO " + target_schema + "." + target_object + " (\n" +
	"    source_instance_id," + "\n" +
	"    batch_id," + "\n" +
	"    ingested_at," + "\n" +
	"    is_deleted," + "\n" +
	"    deleted_at," + "\n" +
	"    " + insertCols + "\n" +
    ")\n" +
    "SELECT\n" +
	"    s.source_instance_id," + "\n" +
	"    s.batch_id," + "\n" +
	"    CURRENT_TIMESTAMP," + "\n" +
	"    s.is_deleted," + "\n" +
	"    s.deleted_at," + "\n" +
    "    " + selectCols + "\n" +
    "FROM " + target_schema + "." + target_object_stage + " s\n" +
    "WHERE s.batch_id = " + batch_id + "\n" +
    "  AND " + target_key_composite1 +
    "  AND s.updated_date IS NOT NULL\n" +
    "  AND NOT EXISTS (\n" +
    "      SELECT 1\n" +
    "      FROM " + target_schema + "." + target_object_stage + " d\n" +
    "      WHERE d.batch_id = s.batch_id\n" +
    "        AND d.source_instance_id = s.source_instance_id\n" +
    "        AND " + target_key_composite2 +
    "      GROUP BY " + "\n" +
	"        d.source_instance_id," + "\n" +
	"        " + target_key_composite3 +
    "      HAVING COUNT(*) > 1\n" +
    "  )\n" +
    "ON CONFLICT " + conflictCols + "\n" +
    "DO UPDATE SET\n" +
	"    batch_id = EXCLUDED.batch_id," + "\n" +
    "    is_deleted = EXCLUDED.is_deleted," + "\n" +
    "    deleted_at = EXCLUDED.deleted_at," + "\n" +
    "    " + updateSet + "\n" +
    "WHERE " + whereUpdate + "\n";</jsScript_script>
      </jsScript>
    </jsScripts>
